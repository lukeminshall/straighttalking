# Straight Talking — environment
# Copy to .env.local and fill in. Nothing here is wired yet; these are the
# integration points the app is built to accept (see README > Data).

# --- Supabase (feedback storage, aggregates, you-said-we-did content) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Clerk (operator auth on /app; patient app + board stay anonymous) ---
# Reminder: the Supabase JWT template must include "role": "authenticated"
# or RLS silently returns empty arrays.
VITE_CLERK_PUBLISHABLE_KEY=

# --- Routing hand-offs ---
# Public review deep-link target for praise (one-tap Google review)
VITE_GOOGLE_REVIEW_URL=
# Governance sink for concerns (Datix / Radar endpoint or webhook)
VITE_GOVERNANCE_WEBHOOK_URL=

# --- Public form base (used to build per-site QR targets) ---
VITE_FORM_BASE_URL=https://straighttalking.co.uk/f

# --- Payments (server-side only; set in Netlify env, never in the client) ---
# Stripe secret key enables /.netlify/functions/create-checkout (card checkout).
STRIPE_SECRET_KEY=
# Signing secret for the Stripe webhook endpoint (checkout + renewals).
STRIPE_WEBHOOK_SECRET=
# Where invoice requests (Trust / PO) are notified until Xero is wired.
INVOICE_NOTIFY_EMAIL=
# --- Xero (optional: raise draft invoices for PO / net-terms buyers) ---
# OAuth2 access token (refreshed server-side) and the target tenant/org id.
XERO_ACCESS_TOKEN=
XERO_TENANT_ID=

# --- Prodigi (print + drop-ship the physical materials) ---
# API key from the Prodigi dashboard. Leave PRODIGI_ENV unset (or =sandbox) to
# test; set PRODIGI_ENV=live to place real orders.
PRODIGI_API_KEY=
PRODIGI_ENV=sandbox
# Public origin used to build artwork asset URLs Prodigi fetches. Netlify sets
# URL automatically; set PUBLIC_URL to override (e.g. the custom domain).
PUBLIC_URL=
